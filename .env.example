# ==============================================================================
# SEE AI — Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in the required values.
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] enable additional features when configured.
# ==============================================================================

# --- Database -----------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string.
# For local dev: postgresql://postgres:postgres@localhost:5432/see_ai
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/see_ai"

# --- Authentication -----------------------------------------------------------
# [REQUIRED] Secret used to encrypt sessions/tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# [REQUIRED] The canonical URL of the application.
AUTH_URL="http://localhost:3000"

# [OPTIONAL] Google OAuth — enables "Sign in with Google"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI Providers -------------------------------------------------------------
# [REQUIRED — at least one] Google Gemini API key.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# [OPTIONAL] Gemini model to use. Defaults to gemini-2.5-flash if unset.
GEMINI_MODEL="gemini-2.5-flash"

# [OPTIONAL] Anthropic Claude API key — enables Claude as a provider.
ANTHROPIC_API_KEY=""

# [OPTIONAL] Claude model to use. Defaults to claude-sonnet-4-20250514 if unset.
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# --- Web Search ---------------------------------------------------------------
# [OPTIONAL] Enable web search integration.
# Supported providers: "google" (uses Gemini grounding), "brave", "serpapi"
WEB_SEARCH_PROVIDER=""
WEB_SEARCH_API_KEY=""

# --- Application --------------------------------------------------------------
# [OPTIONAL] Maximum file upload size in bytes. Default: 10MB
MAX_UPLOAD_SIZE="10485760"

# [OPTIONAL] Log level: "debug" | "info" | "warn" | "error". Default: "info"
LOG_LEVEL="info"

# [OPTIONAL] Node environment
NODE_ENV="development"
